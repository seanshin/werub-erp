# 병원 ERP 운영 환경변수 예시 — `cp .env.example .env` 후 값 채우기.
# ⚠ .env는 git 미추적(.gitignore). 권한 600 권장. 시크릿 평문 보관 최소화(§6.4).
# 격리망 on-prem · HIS 동거 서버. 외부 통신은 프록시/화이트리스트 경유.

# ── 실행 환경 ───────────────────────────────────────────────
ENV=prod
TZ=Asia/Seoul

# ── 데이터베이스 (운영: HIS 동거 서버의 기존 PostgreSQL 재사용 — 별도 DB `erp`) ──
# 컨테이너에서 호스트 PG 접근: host.docker.internal (compose extra_hosts 설정됨).
# 전용 롤/DB 선생성: CREATE ROLE erp_app LOGIN PASSWORD '...'; CREATE DATABASE erp OWNER erp_app;
DATABASE_URL=postgresql+asyncpg://erp_app:CHANGE_ME@host.docker.internal:5432/erp

# ── Redis (ERP 전용 컨테이너, prod compose가 기동) ──────────
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=CHANGE_ME

# ── 인증/암호화 시크릿 (§6.4 — 절대 커밋 금지) ──────────────
# JWT_SECRET_FILE 설정 시 파일 우선(권장). 미설정 시 JWT_SECRET 사용.
JWT_SECRET_FILE=/run/secrets/jwt_secret
# JWT_SECRET=               # 파일 미사용 시 32바이트 이상 무작위 문자열
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# AES-256 컬럼 암호화 키(hex 64자) — `openssl rand -hex 32`. 두 키는 분리 필수.
DATA_ENC_KEY=CHANGE_ME_openssl_rand_hex_32
PHONE_BIDX_KEY=CHANGE_ME_openssl_rand_hex_32_DIFFERENT

# ── 프론트 / CORS ───────────────────────────────────────────
WEB_ORIGIN=https://erp.hospital.local
NEXT_PUBLIC_API_URL=https://erp.hospital.local/api/v1

# ── 외부 연동 (미설정 시 각 수집 잡 대기 모드 — 코어는 정상 기동) ──
HOSPITAL_CODE=WRB-DEMO-M66M

# 그룹웨어(Clinic) 근태·연차 — GroupwareAttendanceSource
CLINIC_API_BASE=https://clinic.example.org
CLINIC_API_KEY=

# HIS(Hospital RUN) 환자·수납 — HISPatientSource (엔드포인트 계약 확정 후 활성)
HIS_API_BASE=https://his.example.org
HIS_API_KEY=

# HIS SSO — HIS의 AUTH_SECRET 공유(HIS 발급 JWT 서명 검증). 미설정 시 SSO 비활성.
HIS_JWT_SECRET=
# 보안 하드닝(권장 운영 설정):
#  · TRUSTED_HOSTS: 리다이렉트/쿠키 베이스 Host 화이트리스트(H-1 open redirect 방어). 미설정=헤더 신뢰.
#  · SSO_ALLOWED_EMAIL_DOMAINS: SSO 허용 이메일 도메인(쉼표). 미설정=전체 허용.
TRUSTED_HOSTS=his.example.org
SSO_ALLOWED_EMAIL_DOMAINS=
#  · HIS_JWT_AUDIENCE: 설정 시 HIS 토큰 aud 강제 검증(C-2 토큰 confusion 차단). HIS가 aud 발급 후 설정.
HIS_JWT_AUDIENCE=

# 공공 수가 마스터(data.go.kr) — FeeMasterSyncSource (M0b 화이트리스트 등록 후)
FEE_API_BASE=https://apis.data.go.kr
FEE_API_SERVICE_KEY=

# AI 색인 발신(example.org) — worker-integration (미설정 시 큐 적재만)
WEVE_AI_API_BASE=
WEVE_AI_API_KEY=

# 심평원 통보서 파일 드롭 수신 경로 (HIS 청구모듈 EDI 수신함 — 볼륨 마운트)
NOTICE_DROP_DIR=/data/notice-drop

# 전자결재(HIS W.Sign 릴레이) — 콜백 수신은 시크릿만으로 동작, 상신은 경로 확정 후 enabled=true
HIS_EAPPROVAL_BASE=https://his.example.org
HIS_INTEGRATION_KEY=          # ERP→HIS X-Integration-Key (HIS 발급)
EAPPROVAL_CALLBACK_SECRET=    # HIS→ERP 콜백 HMAC 검증 시크릿 (HIS 발급)
EAPPROVAL_SUBMIT_ENABLED=false

# HIS→ERP 인박스 웹훅 게이트웨이 (/integrations/his/{domain}/webhook)
HIS_WEBHOOK_KEY=              # 정적 X-Integration-Key 검증(미설정 시 게이트웨이 비활성)
# 본문 HMAC+timestamp(S-1/S-2 동형) — 정적키 외 본문 무결성·재생방지. 무중단 전환:
#  ENFORCE=false(병행수락·서명 오면 관측로그)→양측 발효 확인→ENFORCE=true(서명 필수·미서명 403).
INBOUND_WEBHOOK_SECRET=       # 본문서명 전용 시크릿(정적키와 분리, HIS 발급·안전채널)
INBOUND_WEBHOOK_HMAC_ENFORCE=false
INBOUND_WEBHOOK_MAX_SKEW=300  # ts 신선도 창(초)

# 셀프서비스 BI(Metabase) 자동 로그인 브리지 — 미설정 시 /erp/mb/ 진입 에러(런북 bi-tools §선결).
METABASE_SSO_USER=            # Metabase 공용계정(경영 역할 사용자만 브리지 통과·prod metabase-sso.txt)
METABASE_SSO_PASSWORD=
METABASE_INTERNAL_BASE=http://erp-metabase:3000   # core→Metabase 내부 경로(docker_default)

# ══ 다른 기관·다른 호스트에 설치할 때 반드시 바꿀 값  ══
# 아래 기본값 중 일부는 특정 설치본(example.org) 주소다. 새 기관은 자기 주소로 덮어쓴다.

# 아웃바운드 허용 호스트(CSV) — *_BASE의 호스트를 여기에도 **따로** 적어야 호출이 나간다
# (INV-NET-01: 주소 오설정만으로 직원 보수·환자 청구 데이터가 새지 않게 하는 이중 확인).
# 실효 목록은 관리화면 /admin/integrations '연동 상태'에서 확인.
HIS_ALLOWED_HOSTS=            # 예: his.example-hospital.kr (HIS_API_BASE·HIS_EAPPROVAL_BASE 호스트)
CLINIC_ALLOWED_HOSTS=         # 예: gw.example-hospital.kr (CLINIC_API_BASE 호스트)
AI_ALLOWED_HOSTS=             # 예: ai.example-hospital.kr (WEVE_AI_API_BASE 호스트·https 필수)

# 증빙·계약 첨부 저장 경로 — compose가 erp_attachments 볼륨을 core·worker-batch 양쪽에 마운트.
# ⚠ 미설정이면 첨부 업로드·계약 서명 개시가 422로 멈춘다.
ATTACHMENT_DIR=/data/attachments

# 패스키(WebAuthn) — 신뢰 당사자(RP) = 사용자가 브라우저로 여는 ERP 호스트. 틀리면 패스키 로그인 불가.
# (빈 값으로 두면 기본값을 덮어 패스키가 깨진다 — 주석을 풀고 값을 넣는다)
# WEBAUTHN_RP_ID=               # 예: his.example-hospital.kr
# WEBAUTHN_ORIGIN=              # 예: https://his.example-hospital.kr
WEBAUTHN_RP_NAME=병원 ERP

# 전자서명(sign) — 외주 계약 트랙 A·결재 원장 외부 봉인
SIGN_INTERNAL_BASE=http://sign-core:4000/v1
SIGN_API_KEY=                 # sign 소비자 erp 키(requests:write) — 미설정이면 트랙 A·봉인 비활성
SIGN_WEBHOOK_SECRET=          # sign→ERP 웹훅 HMAC
# SIGN_PORTAL_BASE=             # 거래처 포털 공개 주소 예: https://sign.example-hospital.kr
# SIGN_CALLBACK_URL=            # 예: https://his.example-hospital.kr/erp/api/v1/integrations/sign/webhook

# 검진권 딜러 정산 지급 회신(ERP→HIS) — ⚠ 네 값을 **함께** 설정. 스위치만 켜면 HIS 서명 강제로 전부 401.
DEALER_SETTLEMENT_CALLBACK_ENABLED=false
# HIS_EAPPROVAL_BASE · HIS_INTEGRATION_KEY (위 전자결재 절) +
HIS_FINANCE_WEBHOOK_SECRET=

# AI 공시 색인·검색 — core(검색)와 worker-integration(색인 발신) **둘 다** 이 .env를 읽는다
# (compose x-erp-env 공유). 개별 env로 띄우면 worker-integration 발신 루프가 대기만 한다.
# WEVE_AI_API_BASE · WEVE_AI_API_KEY (위 절)
