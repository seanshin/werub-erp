# ERP 자체 BI 도구(docker-compose.bi.yml) 환경 — 600 권한, 미커밋.
# cp .env.bi.example .env.bi 후 값 채움.

# erp_bi 읽기전용 롤 비밀번호 — 정본은 prod infra/.env.bi(600). ⚠ 종전 메모 파일
# ~/hospital-erp/erp-bi-secret.txt 는 2026-09-09 서버 이전 후 부재(9/8 백업에도 없음).
ERP_BI_PASSWORD=

# Grafana 관리자 초기 비밀번호(강한 값). 최초 로그인 후 변경 권장.
GF_ADMIN_PASSWORD=

# Grafana auth.proxy 신뢰 소스 화이트리스트(nginx 소스) — 미설정 시 docker 기본 대역/loopback.
# GF_AUTH_PROXY_WHITELIST=172.16.0.0/12,127.0.0.1/32

# Metabase 관리자 계정은 최초 1회 API로 생성됨(비번 메모 파일은 유실 — 런북 §3 참조).
# ERP 자동 로그인 브리지는 별도 공용계정을 ERP core .env에 설정(런북 §선결):
#   METABASE_SSO_USER / METABASE_SSO_PASSWORD / METABASE_INTERNAL_BASE
